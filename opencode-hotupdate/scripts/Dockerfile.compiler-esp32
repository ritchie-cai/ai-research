# Dockerfile.compiler-esp32
# ESP32 编译沙箱镜像
# 其他芯片平台复制此文件，替换工具链安装部分

FROM ubuntu:22.04

# 禁止交互式安装
ENV DEBIAN_FRONTEND=noninteractive

# ── 安装 ESP32 工具链 ──────────────────────────────────────
RUN apt-get update && apt-get install -y \
    git curl wget python3 python3-pip cmake ninja-build \
    gcc-xtensa-lx106 \
    && rm -rf /var/lib/apt/lists/*

# 安装 ESP-IDF（按需选择版本）
RUN git clone --depth=1 --branch v5.1 \
    https://github.com/espressif/esp-idf.git /opt/esp-idf \
    && /opt/esp-idf/install.sh esp32

ENV IDF_PATH=/opt/esp-idf

# ── 安装 Node.js（运行 compiler-worker.js） ───────────────
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# ── 复制 worker ───────────────────────────────────────────
WORKDIR /app
COPY scripts/compiler-worker.js .
COPY package.compiler.json package.json
RUN npm install

# ── 运行时不以 root 执行（安全加固） ─────────────────────
RUN useradd -m -u 1001 compiler
USER compiler

EXPOSE 8080
CMD ["node", "compiler-worker.js"]
